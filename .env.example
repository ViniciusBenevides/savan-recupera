# SAVAN Recupera — variáveis de ambiente (raiz)
# Copie para `.env` e preencha. NUNCA commite o `.env` real.
# Formato: KEY=valor (lido por import/importar_planilha.py e n8n/criar_workflows.py).
# Linhas em branco e as que começam com # são ignoradas.

# --- Asaas ---
ASAAS_API_KEY_SANDBOX=
ASAAS_WALLET_ID_SANDBOX=
ASAAS_API_KEY_PROD=
ASAAS_WALLET_ID_PROD=
ASAAS_MC_CRED_WALLET_ID=
ASAAS_WEBHOOK_TOKEN=

# --- Chatwoot ---
CHATWOOT_TOKEN=
CHATWOOT_URL=https://<seu-chatwoot>/

# --- Evolution API (canal WhatsApp / Baileys) ---
# Ver "Guias Operacionais/Baileys — Guia Operacional.md".
# A sessão do WhatsApp NÃO fica aqui nem no Supabase: ela vive no Postgres da própria Evolution.
EVOLUTION_URL=https://<sua-evolution>
EVOLUTION_API_KEY=

# --- baileys-api (fazer-ai) — o canal Baileys NATIVO do Chatwoot ---
# Segundo transporte não-oficial, ao lado da Evolution (chips.conector = 'baileys_chatwoot').
# Ver "Guias Operacionais/baileys-api (Chatwoot) — Guia Operacional.md".
# Aqui a sessão vive no Redis DESSE serviço (com AOF ligado) — nunca no Supabase.
# Header de auth: x-api-key. O endereço de cada número é o próprio E.164, com o "+".
BAILEYS_API_URL=https://<seu-baileys-api>
BAILEYS_API_KEY=

# --- Supabase ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_API_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_DASHBOARD_URL=https://supabase.com/dashboard/project/<SUPABASE_PROJECT_REF>/settings/api-keys/legacy
SUPABASE_ACCESS_TOKEN=

# --- Salvy ---
SALVY_URL=https://salvy.com.br/

# --- n8n ---
N8N_URL=https://<seu-n8n>/
N8N_EMAIL=
N8N_PASSWORD=
N8N_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Meta / WhatsApp Cloud API (conector oficial) ---
# Referência do número de teste; no dia a dia cada chip guarda as suas credenciais no banco.
# APP_ID + APP_SECRET (Configurações do app → Básico) são o que deixa o SAVAN configurar o
# webhook do app sozinho, sem passar pelo painel da Meta.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_ID=
META_APP_SECRET=
