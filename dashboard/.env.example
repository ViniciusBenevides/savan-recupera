# Dashboard (Next.js) — variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA commite o `.env.local` real.
# As mesmas variáveis ficam configuradas no projeto da Vercel (produção).

# Nome do produto nas abas do navegador e no link compartilhado (white-label). Padrão: "MC COB".
NEXT_PUBLIC_APP_NAME=MC COB
# Endereço público do painel (ex.: https://cobranca.exemplo.com.br), para a imagem do link
# compartilhado. Opcional na Vercel, que o Next descobre sozinho.
NEXT_PUBLIC_SITE_URL=
# Libera conectar linha nova de WhatsApp (chip de bot). Só ponha 1 quando o Chatwoot configurado aqui
# estiver numa conta só do MC COB. Sem ela, o cadastro de linha fica travado com aviso.
LINHAS_WHATSAPP_LIBERADAS=

NEXT_PUBLIC_SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CHATWOOT_URL=https://<seu-chatwoot>
CHATWOOT_TOKEN=
CHATWOOT_ACCOUNT_ID=1

# Evolution API — provisionar número, ler QR e ligar o Chatwoot pelo painel.
EVOLUTION_URL=https://<sua-evolution>
EVOLUTION_API_KEY=
